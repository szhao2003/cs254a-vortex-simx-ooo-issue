+bool is_window_alu(const instr_trace_t* trace) {
+  const auto& instr = *trace->instr_ptr;
+  return std::holds_alternative<AluType>(trace->op_type)
+      && !instr.is_macro_op() && !instr.is_wstall()
+      && (instr.get_fu_lock() == instr.get_fu_unlock())
+      && !instr.fcsr_reads() && !instr.fcsr_writes();
+}
+
+bool can_cross_in_window(const instr_trace_t* trace) {
+  if (is_window_alu(trace))
+    return true;
+  const auto* lsu = std::get_if<LsuType>(&trace->op_type);
+  const auto& instr = *trace->instr_ptr;
+  return lsu && *lsu == LsuType::LOAD
+      && !instr.is_macro_op() && !instr.is_wstall()
+      && (instr.get_fu_lock() == instr.get_fu_unlock());
+}
+
+bool window_register_conflict(const instr_trace_t* older, const instr_trace_t* younger) {
+  auto reads_destination = [](const instr_trace_t* reader, const instr_trace_t* writer) {
+    if (!writer->wb)
+      return false;
+    for (const auto& src : reader->src_regs) {
+      if (src.type == writer->dst_reg.type && src.idx == writer->dst_reg.idx)
+        return true;
+    }
+    return false;
+  };
+  return reads_destination(younger, older)  // RAW
+      || reads_destination(older, younger)  // WAR
+      || (older->wb && younger->wb          // WAW
+          && older->dst_reg.type == younger->dst_reg.type
+          && older->dst_reg.idx == younger->dst_reg.idx);
+}
+
+bool window_option(const char* name) {
+  const char* mode = std::getenv(name);
+  return mode && std::strcmp(mode, "1") == 0;
+}
+
+struct WindowStats {
+  uint64_t issued = 0;
+  uint64_t bypassed = 0;
+  uint64_t blocked_no_candidate = 0;
+  uint64_t blocked_dependency = 0;
+  uint64_t blocked_fu = 0;
+  uint64_t blocked_ready = 0;
+  uint64_t operand_rejects = 0;
+  uint64_t bypass_operand_rejects = 0;
+};
+
