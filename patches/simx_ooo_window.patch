+  // Only packets already delivered to the endpoint are addressable.
+  uint32_t available() const {
+    this->assert_endpoint();
+    return this->queue_size();
+  }
+
+  const Pkt& peek_at(uint32_t index) const {
+    __assert(index < this->available(), "channel index out of range");
+    return storage_.at(index);
+  }
+
+  void pop_at(uint32_t index) {
+    __assert(index < this->available(), "channel index out of range");
+    // Move the selected packet to the front so the ordinary pop accounts for it.
+    for (; index > 0; --index) {
+      std::swap(storage_.at(index), storage_.at(index - 1));
+    }
+    this->queue_pop();
+  }
